class Solution:
    def letterCombinations(self, digits: str) -> List[str]:
        mapping = {
            "2" : "abc",
            "3" : "def",
            "4" : "ghi",
            "5" : "jkl",
            "6" : "mno",
            "7" : "pqrs",
            "8" : "tuv",
            "9" : "wxyz"}
        ans = []

        def backtrack(i, cur_str):
            if len(cur_str) == len(digits):
                ans.append(cur_str)
                return
            for s in mapping[digits[i]]:
                backtrack(i + 1, cur_str + s)
        
        if digits:
            backtrack(0, "")
        return ans
