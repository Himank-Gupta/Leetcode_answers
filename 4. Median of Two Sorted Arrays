class Solution:
    def findMedianSortedArrays(self, nums1: List[int], nums2: List[int]) -> float:
        nums = nums1 + nums2
        nums.sort()
        m = len(nums1)
        n = len(nums2)

        med = 0

        if len(nums)%2 == 1:
            med = int((m + n - 1)/2)
            return nums[med]
        else:
            med = (nums[int((m + n)/2 - 1)] + nums[int((m + n)/2)])
            return med/2
