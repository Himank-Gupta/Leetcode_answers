class Solution:
    def lengthOfLongestSubstring(self, s: str) -> int:
        chars = set()
        l = 0
        res = 0

        for r in range(len(s)):
            while s[r] in chars: #not fi because we might need to remove more than 1 character
                chars.remove(s[l])
                l += 1 #this only updates for a repeated character
            chars.add(s[r])
            res = max(res, r - l + 1) #this calculates the current substring
        return res
