class Solution:
    def fourSum(self, nums: List[int], target: int) -> List[List[int]]:
        nums.sort()
        ans, cache = [], []

        def sum(k, start, target):
            if k != 2:
                for i in range(start, len(nums) - k + 1): #runs for the list and leaves last n - 1 elements
                    if i > start and nums[i] == nums[i - 1]: #skips the repetetion
                        continue
                    cache.append(nums[i])
                    sum(k - 1, i + 1, target - nums[i])
                    cache.pop() #Cleares the cache as recursion goes on
                return
            #base case, basically the 2 inside pointers
            l, r = start, len(nums) - 1
            while l < r:
                if nums[l] + nums[r] < target:
                    l += 1
                elif nums[l] + nums[r] > target:
                    r -= 1
                else:
                    ans.append(cache + [nums[l], nums[r]])
                    l += 1
                    while l < r and nums[l] == nums[l - 1]:
                        l += 1
        sum(4, 0, target)
        return ans
