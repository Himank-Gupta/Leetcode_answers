# Definition for singly-linked list.
# class ListNode:
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution:
    def addTwoNumbers(self, l1: Optional[ListNode], l2: Optional[ListNode]) -> Optional[ListNode]:
        test = ListNode()
        cur = test #This allows for accessing current list from test

        carry = 0
        while l1 or l2 or carry:
            v1 = l1.val if l1 != None else 0 #Assigning current value
            v2 = l2.val if l2 != None else 0

            #Operation
            val = v1 + v2 + carry
            carry = val // 10
            val = val % 10
            cur.next = ListNode(val) #Adding the answer to linked list

            #update pointer
            cur = cur.next #Moving answer list to next node
            l1 = l1.next if l1 != None else None 
            l2 = l2.next if l2 != None else None

        return test.next
